<Project Sdk="Microsoft.NET.Sdk">
  <!-- Android (.NET MAUI) port of VwapScanner. Same strategy, portfolio optimizer and Kite client code, UI instead of a web API. Read-only: it never places orders. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>VwapScanner.Mobile</RootNamespace>
    <AssemblyName>VwapScanner.Android</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>VWAP Scanner</ApplicationTitle>
    <ApplicationId>com.vijaykharde.vwapscanner</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The Kite client reads Zerodha's JSON through "dynamic" (runtime reflection). The Release trimmer removes members that code needs
       (login failed with "BadArgCount" although Zerodha had answered), so Release builds are not trimmed. AOT compilation is switched off with it (Android only supports AOT together with trimming). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation> <!-- Android only allows AOT together with trimming -->
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Lets the green Start button (F5) attach to a Release build, so Visual Studio can show the exception if the app ever crashes. -->
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F4C81" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F4C81" BaseSize="128,128" />
    <!-- appsettings.json and universes\*.txt ship inside the APK (read with FileSystem.OpenAppPackageFileAsync). -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Official Zerodha Kite Connect .NET client (same package and version as VwapScanner). -->
    <PackageReference Include="Tech.Zerodha.KiteConnect" Version="5.0.0" />
    <!-- Replaces the ASP.NET host's configuration: appsettings.json is read from the APK and bound exactly as in the web API. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>
</Project>
